# ============================================================
# 輕鬆記帳同步伺服器 — 環境變數範例
# 複製為 .env 後修改：cp .env.example .env
# 詳細說明見 repo 根目錄 SELF_HOST.md
# ============================================================

# 監聽埠號
PORT=8787

# ────────────────────────────────────────────────
# 模式一：Google OAuth Proxy（既有功能）
# 讓 web 版透過此 proxy 存取 Google Drive。
# 純自架模式不需要（可全部留空 + DISABLE_GOOGLE_OAUTH=1）
# ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 設為 1 = 停用 Google OAuth 路由（純自架模式必填 1）
DISABLE_GOOGLE_OAUTH=1

# CORS 允許的 origin，逗號分隔；* = 全部允許。
# 若搭配官方網頁版前端 (https://jijun.the-walking-fish.com) 使用自架後端，建議設為：
# ALLOWED_ORIGINS=https://jijun.the-walking-fish.com,http://localhost:3000
ALLOWED_ORIGINS=*

# ────────────────────────────────────────────────
# 模式二：純自架同步（Self-Hosted Sync，不綁 Google）
# 設定 SELF_HOST_ADMIN_TOKEN 即啟用（SQLite 資料庫）
# ⚠️ 請用隨機長字串（例如: openssl rand -hex 32）
# 首次啟動會以此 token 建立 admin 帳號（PIN 即此 token）
# ────────────────────────────────────────────────
SELF_HOST_ADMIN_TOKEN=

# 公開註冊開關：
#   0（預設）= 關閉公開註冊。只有 admin 能建帳號（web 設定頁「管理員面板」
#             或 CLI：docker exec -it easy-accounting-sync node src/admin-cli.js create ...）
#   1 = 開放任何人註冊新帳號（不建議對外公開開啟）
# admin 登入後可在 web 設定頁 runtime 切換（會覆寫此 env）。
SELF_HOST_ALLOW_REGISTER=0

# 備份保留筆數（每個使用者）
BACKUP_RETENTION_COUNT=100

# 前端靜態目錄（Docker 內路徑）。
# 預設 Dockerfile 已把前端 build 進 /app/static（同埠提供前端 + API）。
# 若要改用外部 build 的 dist，改成 /app/dist 並在 compose volumes 掛上：
#   - /path/to/your/dist:/app/dist:ro
SELF_HOST_STATIC_DIR=/app/static

# ────────────────────────────────────────────────
# 前端 build 參數（docker compose build-arg，非執行期 env）
# 在 docker-compose.yml 的 build.args 設定：
#   AD_FREE: "1"        1 = 移除所有廣告（自架預設）
#   ACCESS_CODE: "xxx"  前端存取驗證碼（每個瀏覽器 session 首次需輸入；
#                       留空 = 無 gate）。注意：這是 UX 門檻非安全機制。
#   VITE_SYNC_SERVER_URL: "https://sync.yourdomain.com"
#                       前端「伺服器地址」的預設值 = 你的自架網址（build 期注入）。
#                       設定後 App 不再預設指向官方伺服器；留空 = 沿用官方預設。
# ────────────────────────────────────────────────
AD_FREE=1
ACCESS_CODE=
VITE_SYNC_SERVER_URL=
