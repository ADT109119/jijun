            <TextView android:id="@+id/cal_day_39" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="top|end" android:padding="1dp" android:textSize="10sp" android:textColor="#9CA3AF" />
            <TextView android:id="@+id/cal_day_40" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="top|end" android:padding="1dp" android:textSize="10sp" android:textColor="#9CA3AF" />
