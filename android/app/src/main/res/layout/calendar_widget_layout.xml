            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView android:id="@+id/cal_day_14" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="top|end" android:padding="1dp" android:textSize="10sp" android:textColor="#9CA3AF" />
            <TextView android:id="@+id/cal_day_15" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="top|end" android:padding="1dp" android:textSize="10sp" android:textColor="#9CA3AF" />
            <TextView android:id="@+id/cal_day_16" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="top|end" android:padding="1dp" android:textSize="10sp" android:textColor="#9CA3AF" />
            <TextView android:id="@+id/cal_day_17" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="top|end" android:padding="1dp" android:textSize="10sp" android:textColor="#9CA3AF" />
            <TextView android:id="@+id/cal_day_18" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="top|end" android:padding="1dp" android:textSize="10sp" android:textColor="#9CA3AF" />
            <TextView android:id="@+id/cal_day_19" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="top|end" android:padding="1dp" android:textSize="10sp" android:textColor="#9CA3AF" />
            <TextView android:id="@+id/cal_day_20" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="top|end" android:padding="1dp" android:textSize="10sp" android:textColor="#9CA3AF" />
        </LinearLayout>

        <!-- Week 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView android:id="@+id/cal_day_21" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="top|end" android:padding="1dp" android:textSize="10sp" android:textColor="#9CA3AF" />
            <TextView android:id="@+id/cal_day_22" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="top|end" android:padding="1dp" android:textSize="10sp" android:textColor="#9CA3AF" />
            <TextView android:id="@+id/cal_day_23" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="top|end" android:padding="1dp" android:textSize="10sp" android:textColor="#9CA3AF" />
            <TextView android:id="@+id/cal_day_24" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="top|end" android:padding="1dp" android:textSize="10sp" android:textColor="#9CA3AF" />
            <TextView android:id="@+id/cal_day_25" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="top|end" android:padding="1dp" android:textSize="10sp" android:textColor="#9CA3AF" />
            <TextView android:id="@+id/cal_day_26" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="top|end" android:padding="1dp" android:textSize="10sp" android:textColor="#9CA3AF" />
            <TextView android:id="@+id/cal_day_27" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="top|end" android:padding="1dp" android:textSize="10sp" android:textColor="#9CA3AF" />
        </LinearLayout>

        <!-- Week 5 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView android:id="@+id/cal_day_28" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="top|end" android:padding="1dp" android:textSize="10sp" android:textColor="#9CA3AF" />
            <TextView android:id="@+id/cal_day_29" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="top|end" android:padding="1dp" android:textSize="10sp" android:textColor="#9CA3AF" />
            <TextView android:id="@+id/cal_day_30" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="top|end" android:padding="1dp" android:textSize="10sp" android:textColor="#9CA3AF" />
            <TextView android:id="@+id/cal_day_31" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="top|end" android:padding="1dp" android:textSize="10sp" android:textColor="#9CA3AF" />
            <TextView android:id="@+id/cal_day_32" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="top|end" android:padding="1dp" android:textSize="10sp" android:textColor="#9CA3AF" />
            <TextView android:id="@+id/cal_day_33" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="top|end" android:padding="1dp" android:textSize="10sp" android:textColor="#9CA3AF" />
            <TextView android:id="@+id/cal_day_34" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="top|end" android:padding="1dp" android:textSize="10sp" android:textColor="#9CA3AF" />
        </LinearLayout>

        <!-- Week 6 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView android:id="@+id/cal_day_35" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="top|end" android:padding="1dp" android:textSize="10sp" android:textColor="#9CA3AF" />
            <TextView android:id="@+id/cal_day_36" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="top|end" android:padding="1dp" android:textSize="10sp" android:textColor="#9CA3AF" />
