{
    "id": "/",
    "name": "輕鬆記帳",
    "short_name": "輕鬆記帳",
    "description": "簡單實用的記帳 PWA 應用程式",
    "start_url": "/",
    "display": "standalone",
    "background_color": "#ffffff",
    "theme_color": "#00A7E5",
    "orientation": "portrait-primary",
    "scope": "/",
    "lang": "zh-TW",
    "dir": "ltr",
    "prefer_related_applications": false,
    "launch_handler": {
        "client_mode": "focus-existing"
    },
    "share_target": {
        "action": "/",
        "method": "GET",
        "params": {
            "title": "share_title",
            "text": "share_text",
            "url": "share_url"
        }
    },
    "widgets": [
        {
            "tag": "easy-accounting-widget",
            "name": "輕鬆記帳小工具",
            "description": "查看今日收支概覽與快速記帳",
            "template": "easy-accounting-widget",
            "ms_ac_template": "/widgets/template.json",
            "data": "/widgets/data.json",
            "type": "application/json",
            "auth": false,
            "icons": [
                {
                    "src": "/icon/icon.png",
                    "sizes": "192x192",
                    "type": "image/png"
                }
            ],
            "screenshots": [
                {
